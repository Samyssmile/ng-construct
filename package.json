{
  "name": "ng-construct-workspace",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:demo",
    "start:demo": "ng serve demo",
    "build": "npm run build:angular && npm run build:demo",
    "build:angular": "ng build angular",
    "build:demo": "ng build demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@lucide/angular": "^1.0.0-rc.0",
    "@neuravision/construct": "^2.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "axe-core": "^4.11.2",
    "jsdom": "^27.1.0",
    "ng-packagr": "^22.1.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
